#!/usr/bin/python3 -I
"""Reset one USB speakerphone by its ALSA card. Root helper. Stdlib only.

One argument: an ALSA card number (0-99) or the card id (the token in
plughw:CARD=<id>). Resolves /sys/class/sound/cardN/device, walks up to the
USB device that owns it (the directory with both `authorized` and `idVendor`),
and refuses anything that is not the configured speakerphone. The reset is
USBDEVFS_RESET on that device's /dev/bus/usb node. This program never writes
`authorized`. After the reset it requires bConfigurationValue 1 and the ALSA
card again within 8 seconds. It returns as soon as both are back. Otherwise stdout is `refused: config failed`
and the exit status is not 0. No other input. No shell.

GS_USB_RESET_SYSFS and GS_USB_RESET_DEVFS replace /sys and /dev/bus/usb only
when this process is not real root (euid != 0). A root install ignores both,
and it ignores GS_USB_RESET_VERIFY_S. Tests pass an explicit euid to
sysfs_root() and devfs_root(); the command line has no such argument.
"""
import fcntl
import os
import re
import stat
import sys
import tempfile
import time

# Numeric USB ids, lowercase hex without a 0x prefix: the OfficeCore M0 Plus.
# Match is this id only. A product string that says eMeet is not enough.
# The device must also have an audio interface.
EMEET_IDS = frozenset({("328f", "0109")})

# _IO('U', 20). USBDEVFS_RESET on the device's usbfs node.
USBDEVFS_RESET = (ord("U") << 8) | 20
# How long to wait for configuration 1 and the ALSA card after the port reset.
# The poll returns as soon as both are back. 8 seconds covers a slow ALSA return
# without reporting a reset that worked as "config failed".
VERIFY_S = 8.0
# Minimum seconds between two resets, enforced under an exclusive lock.
MIN_INTERVAL_S = 30

_NUM = re.compile(r"^[0-9]{1,2}$")
_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$")
_ALIAS = re.compile(r"^card[0-9]{1,2}$", re.I)


class Refuse(Exception):
    def __init__(self, reason):
        self.reason = reason


def valid_spec(spec):
    if not isinstance(spec, str) or _ALIAS.fullmatch(spec):
        return False
    return bool(_NUM.fullmatch(spec) or _ID.fullmatch(spec))


def _env_root(name, default, euid, reason):
    """A test root. Real root (euid 0) always gets `default` and ignores the env."""
    if euid is None:
        euid = os.geteuid()
    if euid == 0:
        return default
    env = os.environ.get(name, "")
    if not env:
        return default
    parts = env.split("/")
    if not env.startswith("/") or ".." in parts or not all(parts[1:]):
        raise Refuse(reason)
    return os.path.normpath(env)


def sysfs_root(euid=None):
    """Sysfs root. The env override is ignored for real root (euid 0)."""
    return _env_root("GS_USB_RESET_SYSFS", "/sys", euid, "bad sysfs")


def devfs_root(euid=None):
    """usbfs root (/dev/bus/usb). The env override is ignored for real root."""
    return _env_root("GS_USB_RESET_DEVFS", "/dev/bus/usb", euid, "bad device")


def verify_limit(euid=None):
    """Seconds to wait for the card to come back. Root ignores the env and waits VERIFY_S."""
    if euid is None:
        euid = os.geteuid()
    if euid == 0:
        return VERIFY_S
    raw = os.environ.get("GS_USB_RESET_VERIFY_S", "")
    if raw == "":
        return VERIFY_S
    try:
        value = float(raw)
    except ValueError:
        return VERIFY_S
    if value < 0 or value > 10:
        return VERIFY_S
    return value


def _inside(path, root):
    path = os.path.realpath(path)
    root = os.path.realpath(root)
    return path == root or path.startswith(root + os.sep)


def _reg_text(path, limit=128):
    """Text of a regular file. A symlink, or anything else, is None."""
    try:
        st = os.lstat(path)
    except OSError:
        return None
    if not stat.S_ISREG(st.st_mode):
        return None
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return None
    try:
        data = os.read(fd, limit)
    finally:
        os.close(fd)
    return data.decode("utf-8", "replace")


def _cards(sound):
    try:
        names = os.listdir(sound)
    except OSError:
        return []
    return [os.path.join(sound, name) for name in names if re.fullmatch(r"card[0-9]{1,2}", name)]


def resolve_card(sysfs, spec):
    sound = os.path.join(sysfs, "class", "sound")
    if _NUM.fullmatch(spec):
        found = [os.path.join(sound, "card" + spec)]
    else:
        found = []
        for card in _cards(sound):
            text = _reg_text(os.path.join(card, "id"))
            if text is not None and text.strip() == spec:
                found.append(card)
        if len(found) > 1:
            raise Refuse("ambiguous card")
    if len(found) != 1 or not os.path.lexists(found[0]):
        raise Refuse("no card")
    if not _inside(found[0], sysfs):
        raise Refuse("outside device")
    return os.path.realpath(found[0])


def _is_usb_device(path):
    for name in ("authorized", "idVendor"):
        try:
            st = os.lstat(os.path.join(path, name))
        except OSError:
            return False
        if not stat.S_ISREG(st.st_mode):
            return False
    return True


def usb_owner(start, devices):
    """Closest ancestor of start that is a USB device directory under devices."""
    if not _inside(start, devices) or os.path.realpath(start) == os.path.realpath(devices):
        raise Refuse("outside device")
    cur = os.path.realpath(start)
    devices = os.path.realpath(devices)
    for _ in range(32):
        if not cur.startswith(devices + os.sep):
            break
        if _is_usb_device(cur):
            return cur
        parent = os.path.dirname(cur)
        if parent == cur:
            break
        cur = parent
    raise Refuse("not usb")


def has_audio_interface(usb):
    """True when one of the device's own interfaces (<dev>:<cfg>.<n>) is USB audio (class 01)."""
    base = os.path.basename(usb)
    try:
        names = os.listdir(usb)
    except OSError:
        return False
    for name in names:
        if not name.startswith(base + ":"):
            continue
        sub = os.path.join(usb, name)
        if os.path.islink(sub) or not os.path.isdir(sub):
            continue
        text = (_reg_text(os.path.join(sub, "bInterfaceClass")) or "").strip().lower()
        if text == "01":
            return True
    return False


def is_speakerphone(usb):
    if not has_audio_interface(usb):
        return False
    vend = (_reg_text(os.path.join(usb, "idVendor")) or "").strip().lower()
    prod = (_reg_text(os.path.join(usb, "idProduct")) or "").strip().lower()
    return (vend, prod) in EMEET_IDS


def _config_ok(usb):
    return (_reg_text(os.path.join(usb, "bConfigurationValue")) or "").strip() == "1"


def _card_back(sysfs, spec):
    try:
        resolve_card(sysfs, spec)
    except Refuse:
        return False
    return True


def port_reset(usb, devfs, euid):
    """USBDEVFS_RESET on this one device. Never writes `authorized`.

    Root ioctls a character device under /dev/bus/usb. A non-root test whose
    stand-in is a regular file records the same request as the bytes
    USBDEVFS_RESET. A symlink is refused either way.
    """
    bus = (_reg_text(os.path.join(usb, "busnum")) or "").strip()
    dev = (_reg_text(os.path.join(usb, "devnum")) or "").strip()
    if not re.fullmatch(r"[0-9]{1,3}", bus) or not re.fullmatch(r"[0-9]{1,3}", dev):
        raise Refuse("not usb")
    bus_i, dev_i = int(bus), int(dev)
    if not 1 <= bus_i <= 255 or not 1 <= dev_i <= 255:
        raise Refuse("not usb")
    node = os.path.join(devfs, "%03d" % bus_i, "%03d" % dev_i)
    if not _inside(node, devfs) or os.path.realpath(node) == os.path.realpath(devfs):
        raise Refuse("outside device")
    try:
        st = os.lstat(node)
    except OSError:
        raise Refuse("reset failed")
    if stat.S_ISLNK(st.st_mode):
        raise Refuse("reset failed")
    try:
        fd = os.open(node, os.O_RDWR | os.O_NOFOLLOW)
    except OSError:
        raise Refuse("reset failed")
    try:
        kind = os.fstat(fd).st_mode
        if stat.S_ISCHR(kind):
            if euid != 0:
                raise Refuse("reset failed")
            fcntl.ioctl(fd, USBDEVFS_RESET, 0)
        elif euid != 0 and stat.S_ISREG(kind):
            os.write(fd, b"USBDEVFS_RESET\n")
        else:
            raise Refuse("reset failed")
    except Refuse:
        raise
    except OSError:
        raise Refuse("reset failed")
    finally:
        os.close(fd)


def reset_card(spec, sysfs, euid=None):
    if euid is None:
        euid = os.geteuid()
    if not valid_spec(spec):
        raise Refuse("bad card")
    card = resolve_card(sysfs, spec)
    dev = os.path.join(card, "device")
    if not os.path.lexists(dev):
        raise Refuse("no card")
    start = os.path.realpath(dev)
    devices = os.path.join(sysfs, "devices")
    if not _inside(start, devices):
        raise Refuse("outside device")
    usb = usb_owner(start, devices)
    if not is_speakerphone(usb):
        raise Refuse("not speakerphone")
    if not _inside(usb, devices) or os.path.realpath(usb) == os.path.realpath(devices):
        raise Refuse("outside device")
    port_reset(usb, devfs_root(euid), euid)
    deadline = time.monotonic() + verify_limit(euid)
    while True:
        if _config_ok(usb) and _card_back(sysfs, spec):
            return
        if time.monotonic() >= deadline:
            raise Refuse("config failed")
        time.sleep(0.05)


def lock_path(euid=None):
    """Lock and last-reset file. Root uses /run; tests (not root) use the fake sysfs or tmp."""
    if euid is None:
        euid = os.geteuid()
    if euid == 0:
        return "/run/gs-usb-reset.lock"
    root = sysfs_root(euid)
    if root != "/sys":
        return os.path.join(root, ".gs-usb-reset.lock")
    return os.path.join(tempfile.gettempdir(), "gs-usb-reset-%d.lock" % euid)


def locked_reset(spec, sysfs, lock, now=None, min_interval=None):
    """One reset at a time, and none within MIN_INTERVAL_S of the last good one."""
    now = now or time.time
    gap = MIN_INTERVAL_S if min_interval is None else min_interval
    try:
        fd = os.open(lock, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    except OSError:
        raise Refuse("lock failed")
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise Refuse("lock failed")
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            raise Refuse("busy")
        try:
            last = float(os.pread(fd, 32, 0).decode("ascii", "replace").strip() or 0)
        except ValueError:
            last = 0.0
        t = now()
        if 0 <= t - last < gap:
            raise Refuse("too soon")
        reset_card(spec, sysfs)
        os.ftruncate(fd, 0)
        os.pwrite(fd, ("%d\n" % int(now())).encode("ascii"), 0)
    finally:
        os.close(fd)


def _refuse(reason):
    if not isinstance(reason, str) or not reason or "/" in reason or len(reason) > 64:
        reason = "no"
    sys.stdout.write("refused: " + reason + "\n")
    return 1


def main(argv=None):
    argv = sys.argv if argv is None else argv
    if len(argv) != 2 or not valid_spec(argv[1]):
        return _refuse("bad card")
    try:
        locked_reset(argv[1], sysfs_root(), lock_path())
    except Refuse as exc:
        return _refuse(exc.reason)
    sys.stdout.write("ok\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
