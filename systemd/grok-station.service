[Unit]
Description=grok-station display UI + LAN /show listener
# Start while the splash is still up, then take the display from Plymouth.
After=systemd-user-sessions.service plymouth-start.service
Before=plymouth-quit.service plymouth-quit-wait.service
# Kiosk: getty@tty1 is masked by install.sh (agetty grabbing tty1 breaks KMS page flips). Use SSH.

[Service]
User=grok
SupplementaryGroups=video render input
EnvironmentFile=/etc/grok-station/env
RuntimeDirectory=grok-station
CacheDirectory=grok-station
ExecStartPre=-+/usr/bin/plymouth quit --retain-splash
# No blinking console cursor under the UI (the kernel option vt.global_cursor_default=0 covers boot).
ExecStartPre=-+/bin/sh -c 'setterm --cursor off --blank 0 > /dev/tty1 < /dev/tty1; echo 0 > /sys/class/graphics/fbcon/cursor_blink'
ExecStart=/usr/bin/python3 /opt/grok-station/grok_station.py
Restart=always
RestartSec=3
MemoryMax=300M

[Install]
WantedBy=multi-user.target
