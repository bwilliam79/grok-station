#!/bin/sh
# grok-station admin CLI (root). `sudo grok-station reset-admin`: wipe ONLY the admin password; a new setup code shows
# on the station screen and voice stays off until a new password is set. `boot-check` runs at boot (admin service):
# an empty file named grok-station-reset on the boot partition does the same reset, then is deleted. It also
# runs `tls-cert` (below).
set -eu
AUTH=/var/lib/grok-station/admin/auth.json
TLS="${GROK_TLS_DIR:-/var/lib/grok-station/tls}"   # per-station admin page cert: key.pem (600 grok-admin), cert.pem, fingerprint, host
# `tls-cert` (run at install and before every admin start): make the station's self-signed cert if it is
# missing, if the hostname changed, or if it ends within 30 days. The private key never leaves the station.
tls_cert() {
  h="$(cat "${GROK_HOSTNAME_FILE:-/etc/hostname}" 2>/dev/null | tr -d '[:space:]')"; [ -n "$h" ] || h=grok-station
  if [ -s "$TLS/key.pem" ] && [ -s "$TLS/cert.pem" ] && [ "$(cat "$TLS/host" 2>/dev/null)" = "$h" ] &&
     openssl x509 -in "$TLS/cert.pem" -noout -checkend 2592000 >/dev/null 2>&1; then
    return 0
  fi
  if [ "$(id -u)" = 0 ]; then install -d -o root -g grok -m 0750 "$TLS"; else install -d -m 0750 "$TLS"; fi
  tmp="$(mktemp -d "$TLS/.new.XXXXXX")"
  ( umask 077
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 825 -sha256 \
      -keyout "$tmp/key.pem" -out "$tmp/cert.pem" -subj "/CN=$h.local/O=grok-station" \
      -addext "subjectAltName=DNS:$h.local,DNS:$h,IP:10.42.0.1" \
      -addext "basicConstraints=critical,CA:FALSE" -addext "keyUsage=critical,digitalSignature" \
      -addext "extendedKeyUsage=serverAuth" >/dev/null 2>&1 )
  chmod 600 "$tmp/key.pem"; chmod 644 "$tmp/cert.pem"
  if [ "$(id -u)" = 0 ]; then chown grok-admin:grok "$tmp/key.pem"; chown root:grok "$tmp/cert.pem"; fi
  openssl x509 -in "$tmp/cert.pem" -noout -fingerprint -sha256 | sed 's/^.*=//' > "$tmp/fingerprint"
  printf '%s\n' "$h" > "$tmp/host"; chmod 644 "$tmp/fingerprint" "$tmp/host"
  for f in key.pem cert.pem fingerprint host; do mv -f "$tmp/$f" "$TLS/$f"; done
  rmdir "$tmp"
  command -v logger >/dev/null && logger -t grok-station "admin TLS cert made for $h.local (sha256 $(cat "$TLS/fingerprint"))"
}
reset() {
  [ -f "$AUTH" ] || { echo "No admin password is set yet (setup code is on the station screen)."; return 0; }
  # auth.json sits in $V/admin, which grok-admin owns: open it and write the new one through that folder's
  # descriptor, never by path, so a planted auth.json or temp symlink is not followed (Nix 0.13.6 M-pre2).
  /usr/bin/python3 - "$AUTH" <<'PY'
import json, os, secrets, stat, sys, time
f = sys.argv[1]
folder, name = os.path.split(f)
NF = os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
dfd = os.open(folder, os.O_RDONLY | os.O_DIRECTORY | NF)
try:
    try:
        cur = os.open(name, os.O_RDONLY | os.O_NONBLOCK | NF, dir_fd=dfd)
    except OSError:
        sys.exit("refusing to reset: %s is a symlink or can't be opened" % f)
    with os.fdopen(cur) as fh:
        st = os.fstat(fh.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            sys.exit("refusing to reset: %s is not a plain file with one link" % f)
        d = json.load(fh)
    d.pop("password", None); d["reset_at"] = int(time.time())
    own = os.fstat(dfd)  # stays the admin service user's, as before: folder owner and group, mode 0600
    tmp = ".%s.new.%s" % (name, secrets.token_hex(8))
    out = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | NF, 0o600, dir_fd=dfd)
    try:
        with os.fdopen(out, "w") as fh:
            json.dump(d, fh)
            fh.flush()
            os.fchown(fh.fileno(), own.st_uid, own.st_gid)
            os.fchmod(fh.fileno(), 0o600)
        os.rename(tmp, name, src_dir_fd=dfd, dst_dir_fd=dfd)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=dfd)
        except OSError:
            pass
        raise
finally:
    os.close(dfd)
PY
  rm -f /run/grok-station-admin/setup.json
  echo "Admin password reset. The new setup code is on the station screen."
}
case "${1:-}" in
  reset-admin)
    [ "$(id -u)" = 0 ] || { echo "Run with sudo." >&2; exit 1; }
    reset; systemctl restart grok-station-admin ;;
  tls-cert)
    [ "$(id -u)" = 0 ] || [ -n "${GROK_TLS_DIR:-}" ] || { echo "Run with sudo." >&2; exit 1; }
    tls_cert; cat "$TLS/fingerprint" ;;
  boot-check)
    tls_cert || logger -t grok-station "admin TLS cert: could not make one"
    for f in /boot/firmware/grok-station-reset /boot/grok-station-reset; do
      if [ -e "$f" ]; then rm -f "$f"; sync; reset; logger -t grok-station "admin password reset from boot partition file"; fi
    done ;;
  set-key)
    # Reads the xAI API key from stdin (hidden prompt on a terminal). Never echoed or logged.
    [ "$(id -u)" = 0 ] || { echo "Run with sudo." >&2; exit 1; }
    if [ -t 0 ]; then printf 'xAI API key (input hidden): ' >&2; stty -echo; IFS= read -r k; stty echo; echo >&2
    else IFS= read -r k; fi
    [ -n "$k" ] || { echo "No key given." >&2; exit 1; }
    d=/etc/grok-station/secrets; install -d -o root -g root -m 0711 "$d"
    t="$(mktemp "$d/.k.XXXXXX")"; printf '%s\n' "$k" > "$t"; unset k
    chown grok-relay:grok-admin "$t"; chmod 0400 "$t"; mv -f "$t" "$d/xai_api_key"
    systemctl restart grok-station-relay; echo "Key saved. Relay restarted." ;;
  *) echo "usage: sudo grok-station reset-admin | set-key | tls-cert" >&2; exit 2 ;;
esac
