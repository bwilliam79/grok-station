#!/bin/bash
# grok-voice-add-webhook <bot>: add/replace one bot's routine webhook in webhooks.json (mode 600, home computer only).
# Prompts for the URL and the key (hidden). The relay calls it with "Authorization: Bearer <key>" and hot-reloads.
# Prints only "ok <bot>". Never echoes the URL or key.
set -euo pipefail
export PATH=/opt/homebrew/bin:/usr/local/bin:$PATH
BOTS="rhea kai hank finn piper miles nix noor mira cade hadley wren sloan ash jules"
bot="${1:-}"; [[ " $BOTS " == *" $bot "* ]] || { echo "usage: grok-voice-add-webhook <bot>  ($BOTS)" >&2; exit 2; }
F="$HOME/docker/grok-station-secrets/webhooks.json"
read -r -p "Webhook URL for $bot: " url
[[ "$url" =~ ^https://[^[:space:]]+$ ]] || { echo "URL must start with https://" >&2; exit 2; }
read -r -s -p "Webhook key for $bot (hidden): " key; echo >&2
[ -n "$key" ] || { echo "empty key" >&2; exit 2; }
umask 077
BOT="$bot" URL="$url" KEY="$key" F="$F" /usr/bin/python3 - <<'PY'
import json, os
f = os.environ["F"]
try:
    d = json.load(open(f))
except (OSError, ValueError):
    d = {}
d[os.environ["BOT"]] = {"url": os.environ["URL"], "token": os.environ["KEY"]}
data = json.dumps(d, indent=1) + "\n"
fd = os.open(f, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)   # in place: keeps the inode the relay's bind mount sees
os.write(fd, data.encode()); os.close(fd); os.chmod(f, 0o600)
PY
unset key url
# The relay reloads on change; confirm the container sees this bot, else restart it when idle.
seen() { docker exec grok-station-relay python -c "import json,sys;sys.exit(0 if sys.argv[1] in json.load(open('/run/secrets/webhooks')) else 1)" "$bot" 2>/dev/null; }
if ! seen; then
  for i in $(seq 1 60); do docker logs --since 20s grok-station-relay 2>&1 | grep -qE "xai |turn " || break; sleep 5; done
  (cd "$HOME/docker/grok-station/relay" && docker compose restart relay >/dev/null 2>&1)
  sleep 3; seen || { echo "relay does not see $bot yet" >&2; exit 1; }
fi
echo "ok $bot"
