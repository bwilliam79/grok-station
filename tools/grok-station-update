#!/bin/sh
# Runs as grok-station-update.service (root, oneshot), started from the admin page's Update button through the
# root helper (update-start). Same path as the bootstrap one-liner: pull main in the clone install.sh last ran
# from, then run install.sh. No arguments are taken from anywhere.
# Refuses origin/main when its VERSION is not strictly newer than /opt/grok-station/VERSION.
set -eu
SRC=$(cat /etc/grok-station/source-dir 2>/dev/null || true)
[ -n "$SRC" ] && [ -f "$SRC/bootstrap.sh" ] && [ -d "$SRC/.git" ] || { echo "No grok-station clone recorded in /etc/grok-station/source-dir" >&2; exit 1; }
# semver-order:start
semver_order() {
  awk -v inst="$1" -v avail="$2" '
function ok(s,    n, a, i) {
  if (s == "" || s ~ /[^0-9.]/) return 0
  n = split(s, a, ".")
  if (n != 3) return 0
  for (i = 1; i <= 3; i++) if (a[i] !~ /^[0-9]+$/) return 0
  return 1
}
BEGIN {
  if (!ok(avail)) { print "unknown"; exit }
  if (!ok(inst)) { print "newer"; exit }
  split(inst, I, ".")
  split(avail, A, ".")
  for (i = 1; i <= 3; i++) {
    if (A[i] + 0 > I[i] + 0) { print "newer"; exit }
    if (A[i] + 0 < I[i] + 0) { print "older"; exit }
  }
  print "same"
}'
}
# semver-order:end
INSTALLED=
if [ -f /opt/grok-station/VERSION ]; then
  INSTALLED=$(tr -d '[:space:]' < /opt/grok-station/VERSION)
fi
git -c safe.directory="$SRC" -C "$SRC" fetch --quiet origin main \
  || { echo "Couldn't fetch the main branch." >&2; exit 1; }
REMOTE=$(git -c safe.directory="$SRC" -C "$SRC" show origin/main:VERSION 2>/dev/null || true)
REMOTE=$(printf '%s' "$REMOTE" | tr -d '[:space:]')
order=$(semver_order "$INSTALLED" "$REMOTE")
if [ "$order" = "same" ]; then
  echo "Already up to date."
  exit 0
fi
if [ "$order" != "newer" ]; then
  msg="Refusing to install ${REMOTE:-nothing} over ${INSTALLED:-nothing}. The main branch is older than this station."
  printf '%s\n' "$msg" >> /var/log/grok-station-install.log 2>/dev/null || true
  echo "$msg" >&2
  exit 1
fi
export GROK_STATION_DIR="$SRC" NO_COLOR=1 GROK_STATION_NONINTERACTIVE=1  # update mode: restart in place, never prompt or reboot
exec sh "$SRC/bootstrap.sh"
