#!/usr/bin/env python3
"""Sign and seal one answer for a grok-station, or print a new bot key.

Stdlib and PyNaCl only. The seed is read from GROK_STATION_BOT_KEY and is never taken from
an argument or a file. This does not import the station relay.
"""
import argparse, base64, hashlib, http.client, json, os, ssl, sys
from urllib.parse import urlsplit

from nacl.public import PublicKey, SealedBox
from nacl.signing import SigningKey

_REFUSED = ("--key", "--seed", "--bot-key", "--private-key", "--secret")


def canonical(request_id, text):
    body = {"action_class": "answer", "request_id": request_id, "text": text, "tier": 0}
    return json.dumps(body, separators=(",", ":"), sort_keys=True).encode()


def build_outer(bot, request_id, text, seed_b64, station_pub_b64):
    """Outer JSON bytes: {"v":1,"bot":...,"sealed":...}. Raises ValueError on a bad key."""
    seed = base64.b64decode("".join(str(seed_b64).split()), validate=True)
    pub = base64.b64decode("".join(str(station_pub_b64).split()), validate=True)
    if len(seed) != 32 or len(pub) != 32:
        raise ValueError("key")
    signed = SigningKey(seed).sign(canonical(request_id, text))
    sealed = SealedBox(PublicKey(pub)).encrypt(signed)
    outer = {"v": 1, "bot": bot, "sealed": base64.b64encode(sealed).decode()}
    return json.dumps(outer, separators=(",", ":")).encode()


def keygen_lines():
    sk = SigningKey.generate()
    seed = base64.b64encode(bytes(sk)).decode()
    pub = base64.b64encode(bytes(sk.verify_key)).decode()
    return f"GROK_STATION_BOT_KEY={seed}", f"public: {pub}"


def _refused(argv):
    for arg in argv:
        head = arg.split("=", 1)[0]
        if head in _REFUSED or "GROK_STATION_BOT_KEY=" in arg:
            return True
    return False


def _pin(text):
    if not isinstance(text, str):
        return ""
    fp = text.replace(":", "").strip().lower()
    if len(fp) != 64 or any(c not in "0123456789abcdef" for c in fp):
        return ""
    return fp


class _Conn(http.client.HTTPSConnection):
    def __init__(self, host, port, context, pin, timeout):
        super().__init__(host, port, context=context, timeout=timeout)
        self._pin = pin

    def connect(self):
        super().connect()
        if not self._pin:
            return
        der = self.sock.getpeercert(binary_form=True)
        if hashlib.sha256(der).hexdigest() != self._pin:
            try:
                self.sock.close()
            except Exception:
                pass
            raise ssl.SSLError("pin")


def post_reply(origin, body, insecure=False, pin=""):
    """POST /voice/reply. Returns (status, verdict). Raises ssl.SSLError('pin') on a pin miss."""
    parts = urlsplit(origin)
    if parts.scheme != "https" or not parts.hostname or parts.username or parts.password:
        raise ValueError("https")
    ctx = ssl.create_default_context()
    if insecure:
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
    conn = _Conn(parts.hostname, parts.port or 443, ctx, pin, 15)
    try:
        conn.request("POST", "/voice/reply", body=body, headers={"Content-Type": "application/json"})
        resp = conn.getresponse()
        resp.read()
        status = resp.status
    finally:
        conn.close()
    verdict = {200: "ok", 400: "bad request", 403: "forbidden", 409: "conflict",
               429: "too many", 404: "not found"}.get(status, "bad request" if status >= 400 else "ok")
    return status, verdict


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if _refused(argv):
        print("refused", file=sys.stderr)
        return 2
    p = argparse.ArgumentParser(prog="grok-station-reply", add_help=True)
    sub = p.add_subparsers(dest="cmd")
    sub.add_parser("keygen")
    send = sub.add_parser("send")
    send.add_argument("--station", required=True)
    send.add_argument("--bot", required=True)
    send.add_argument("--station-pub", required=True)
    send.add_argument("--request-id", required=True)
    send.add_argument("--insecure", action="store_true")
    send.add_argument("--pin-sha256", default="")
    try:
        args = p.parse_args(argv)
    except SystemExit as e:
        return int(e.code or 0)
    if args.cmd == "keygen":
        for line in keygen_lines():
            print(line)
        return 0
    if args.cmd != "send":
        p.print_help(sys.stderr)
        return 2
    if args.insecure and not args.pin_sha256:
        print("insecure requires --pin-sha256", file=sys.stderr)
        return 2
    pin = ""
    if args.pin_sha256:
        pin = _pin(args.pin_sha256)
        if not pin:
            print("bad pin", file=sys.stderr)
            return 2
    text = sys.stdin.read()
    if text.endswith("\n"):
        text = text[:-1]
    if text.endswith("\r"):
        text = text[:-1]
    if not text or len(text) > 400:
        print("400 bad request")
        return 1
    seed = os.environ.get("GROK_STATION_BOT_KEY", "")
    if not seed.strip():
        print("missing GROK_STATION_BOT_KEY", file=sys.stderr)
        return 2
    try:
        body = build_outer(args.bot, args.request_id, text, seed, args.station_pub)
    except Exception:
        print("400 bad request")
        return 1
    try:
        status, verdict = post_reply(args.station, body, insecure=args.insecure, pin=pin)
    except ssl.SSLError as e:
        if "pin" in str(e):
            print("certificate pin mismatch")
            return 1
        print("tls error", file=sys.stderr)
        return 1
    except Exception:
        print("tls error", file=sys.stderr)
        return 1
    print(f"{status} {verdict}")
    return 0 if status == 200 else 1


if __name__ == "__main__":
    sys.exit(main())
