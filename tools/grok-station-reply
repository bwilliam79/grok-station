#!/usr/bin/env python3
"""Sign and seal one answer for a grok-station, post a sealed reply, or print a new bot key.

  seal  answer on stdin, seed from GROK_STATION_BOT_KEY only; prints the outer {v,bot,sealed} JSON.
  seal-list  bot names, one per line on stdin; same outer JSON, inner kind bot_list.
  seal-avatar  a png, jpeg, or webp on stdin; same outer JSON, inner kind avatar.
  post  sealed JSON on stdin; validates it and POSTs it. No key, no PyNaCl (stdlib only).
  post --avatar  a sealed picture, to /voice/avatar. Larger than a reply.
  send  seal | post on one machine.

The seed is never taken from an argument or a file. This does not import the station relay.
"""
import argparse, base64, hashlib, http.client, json, os, re, secrets, ssl, sys, time, unicodedata
from urllib.parse import urlsplit

MAX_BODY = 8192
AVATAR_IMAGE_MAX = 2 << 20
AVATAR_OUTER_MAX = 4 << 20
_REFUSED = ("--key", "--seed", "--bot-key", "--private-key", "--secret")
_LIST_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 .'-]{0,31}$")
_RID = re.compile(r"^vs_[A-Za-z0-9_-]{22}$")
_LIST_MAX = 24


def canonical(request_id, text):
    body = {"action_class": "answer", "kind": "reply", "request_id": request_id, "text": text, "tier": 0}
    return json.dumps(body, separators=(",", ":"), sort_keys=True).encode()


def _list_name(raw):
    """Same name rule as the station. Controls reject; cleaning does not truncate-accept."""
    if not isinstance(raw, str) or not raw:
        return None
    if any(unicodedata.category(c) in ("Cc", "Cf") for c in raw):
        return None
    if any(ord(c) > 127 for c in raw):  # do not NFKC-fold fullwidth or other lookalikes into ASCII
        return None
    t = unicodedata.normalize("NFKC", raw)
    t = "".join(c for c in t if unicodedata.category(c) not in ("Cc", "Cf"))
    t = " ".join(t.split())
    if not t or len(t) > 32 or _LIST_NAME.fullmatch(t) is None:
        return None
    return t


def canonical_list(request_id, names):
    body = {"action_class": "bot_list", "bots": [{"name": n} for n in names], "kind": "bot_list",
            "request_id": request_id, "tier": 0}
    return json.dumps(body, separators=(",", ":"), sort_keys=True).encode()


def build_list_outer(bot, request_id, names, seed_b64, station_pub_b64):
    """Outer JSON bytes for a bot list. Raises ValueError on a bad key, name, or request id."""
    from nacl.public import PublicKey, SealedBox
    from nacl.signing import SigningKey
    if not isinstance(request_id, str) or _RID.fullmatch(request_id) is None:
        raise ValueError("request")
    if not isinstance(names, list) or len(names) > _LIST_MAX:
        raise ValueError("names")
    clean, seen = [], set()
    for raw in names:
        name = _list_name(raw)
        if name is None:
            raise ValueError("name")
        key = name.casefold()
        if key in seen:
            raise ValueError("dup")
        seen.add(key)
        clean.append(name)
    seed = base64.b64decode("".join(str(seed_b64).split()), validate=True)
    pub = base64.b64decode("".join(str(station_pub_b64).split()), validate=True)
    if len(seed) != 32 or len(pub) != 32:
        raise ValueError("key")
    signed = SigningKey(seed).sign(canonical_list(request_id, clean))
    sealed = SealedBox(PublicKey(pub)).encrypt(signed)
    outer = {"v": 1, "bot": bot, "sealed": base64.b64encode(sealed).decode()}
    return json.dumps(outer, separators=(",", ":")).encode()


def _read_list_names():
    """Names, one per line. Empty lines are skipped. None when a line is bad or there are more than 24."""
    text = sys.stdin.read()
    names, seen = [], set()
    for line in text.splitlines():
        if not line.strip():
            continue
        name = _list_name(line)
        if name is None:
            return None
        key = name.casefold()
        if key in seen:
            return None
        seen.add(key)
        names.append(name)
        if len(names) > _LIST_MAX:
            return None
    return names


def build_outer(bot, request_id, text, seed_b64, station_pub_b64):
    """Outer JSON bytes: {"v":1,"bot":...,"sealed":...}. Raises ValueError on a bad key."""
    from nacl.public import PublicKey, SealedBox
    from nacl.signing import SigningKey
    seed = base64.b64decode("".join(str(seed_b64).split()), validate=True)
    pub = base64.b64decode("".join(str(station_pub_b64).split()), validate=True)
    if len(seed) != 32 or len(pub) != 32:
        raise ValueError("key")
    signed = SigningKey(seed).sign(canonical(request_id, text))
    sealed = SealedBox(PublicKey(pub)).encrypt(signed)
    outer = {"v": 1, "bot": bot, "sealed": base64.b64encode(sealed).decode()}
    return json.dumps(outer, separators=(",", ":")).encode()


def keygen_lines():
    from nacl.signing import SigningKey
    sk = SigningKey.generate()
    seed = base64.b64encode(bytes(sk)).decode()
    pub = base64.b64encode(bytes(sk.verify_key)).decode()
    return f"GROK_STATION_BOT_KEY={seed}", f"public: {pub}"


def check_outer(raw, limit=None):
    """Return canonical bytes if raw is exactly {v:1,bot,sealed} and within the size cap, else None.

    The default cap is 8 KiB (a reply or a card). A profile picture passes a larger cap.
    """
    cap = MAX_BODY if limit is None else limit
    if type(cap) is not int or cap < 1 or cap > AVATAR_OUTER_MAX:
        cap = MAX_BODY
    if isinstance(raw, str):
        raw = raw.encode()
    raw = raw.strip()
    if not raw or len(raw) > cap:
        return None
    try:
        obj = json.loads(raw)
    except Exception:
        return None
    if not isinstance(obj, dict) or set(obj) != {"v", "bot", "sealed"}:
        return None
    if obj["v"] != 1 or isinstance(obj["v"], bool):
        return None
    if not isinstance(obj["bot"], str) or not obj["bot"] or not isinstance(obj["sealed"], str):
        return None
    try:
        base64.b64decode(obj["sealed"], validate=True)
    except Exception:
        return None
    out = json.dumps(obj, separators=(",", ":")).encode()
    return out if len(out) <= cap else None


def _refused(argv):
    for arg in argv:
        head = arg.split("=", 1)[0]
        if head in _REFUSED or "GROK_STATION_BOT_KEY=" in arg:
            return True
    return False


def _pin(text):
    if not isinstance(text, str):
        return ""
    fp = text.replace(":", "").strip().lower()
    if len(fp) != 64 or any(c not in "0123456789abcdef" for c in fp):
        return ""
    return fp


class _Conn(http.client.HTTPSConnection):
    def __init__(self, host, port, context, pin, timeout):
        super().__init__(host, port, context=context, timeout=timeout)
        self._pin = pin

    def connect(self):
        super().connect()
        if not self._pin:
            return
        der = self.sock.getpeercert(binary_form=True)
        if hashlib.sha256(der).hexdigest() != self._pin:
            try:
                self.sock.close()
            except Exception:
                pass
            raise ssl.SSLError("pin")


def build_show(bot, doc, seed_b64, station_pub_b64):
    """Seal a card put/clear. doc is the signed JSON (no bot field). Same outer envelope as an answer.

    kind, nonce, and exp_ms are always written here (a fresh nonce, exp about 60 seconds ahead),
    so the same stdin posted twice is two different blobs.
    """
    from nacl.public import PublicKey, SealedBox
    from nacl.signing import SigningKey
    if not isinstance(doc, dict):
        raise ValueError("show")
    doc = dict(doc)
    doc["kind"] = "show"
    doc["nonce"] = secrets.token_urlsafe(16)
    doc["exp_ms"] = int(time.time() * 1000) + 60_000
    seed = base64.b64decode("".join(str(seed_b64).split()), validate=True)
    pub = base64.b64decode("".join(str(station_pub_b64).split()), validate=True)
    if len(seed) != 32 or len(pub) != 32:
        raise ValueError("key")
    body = json.dumps(doc, separators=(",", ":"), sort_keys=True).encode()
    signed = SigningKey(seed).sign(body)
    sealed = SealedBox(PublicKey(pub)).encrypt(signed)
    outer = {"v": 1, "bot": bot, "sealed": base64.b64encode(sealed).decode()}
    return json.dumps(outer, separators=(",", ":")).encode()


def sniff_image(raw):
    """png, jpeg, or webp from the file's own bytes. Empty when it is not one of those."""
    if not isinstance(raw, (bytes, bytearray)) or not raw:
        return ""
    if raw.startswith(b"\x89PNG\r\n\x1a\n"):
        return "image/png"
    if raw.startswith(b"\xff\xd8\xff"):
        return "image/jpeg"
    if len(raw) >= 12 and raw[:4] == b"RIFF" and raw[8:12] == b"WEBP":
        return "image/webp"
    return ""


def build_avatar(bot, image, seed_b64, station_pub_b64):
    """Outer JSON bytes for a profile picture. Raises ValueError on a bad key, type, or size.

    The signed document is kind avatar, a fresh nonce, exp_ms about 60 seconds ahead, the file
    type, and the image. The same bytes sealed twice are two different blobs.
    """
    from nacl.public import PublicKey, SealedBox
    from nacl.signing import SigningKey
    if not isinstance(image, (bytes, bytearray)) or not image or len(image) > AVATAR_IMAGE_MAX:
        raise ValueError("image")
    kind = sniff_image(image)
    if kind not in ("image/png", "image/jpeg", "image/webp"):
        raise ValueError("type")
    seed = base64.b64decode("".join(str(seed_b64).split()), validate=True)
    pub = base64.b64decode("".join(str(station_pub_b64).split()), validate=True)
    if len(seed) != 32 or len(pub) != 32:
        raise ValueError("key")
    doc = {"content_type": kind, "exp_ms": int(time.time() * 1000) + 60_000,
           "image_b64": base64.b64encode(bytes(image)).decode("ascii"), "kind": "avatar",
           "nonce": secrets.token_urlsafe(16)}
    signed = SigningKey(seed).sign(json.dumps(doc, separators=(",", ":"), sort_keys=True).encode())
    sealed = SealedBox(PublicKey(pub)).encrypt(signed)
    outer = {"v": 1, "bot": bot, "sealed": base64.b64encode(sealed).decode()}
    return json.dumps(outer, separators=(",", ":")).encode()


def post_reply(origin, body, insecure=False, pin="", path="/voice/reply"):
    """POST /voice/reply, /voice/show, or /voice/avatar. Returns (status, verdict). Raises ssl.SSLError('pin') on a pin miss."""
    if path not in ("/voice/reply", "/voice/show", "/voice/avatar"):
        raise ValueError("path")
    parts = urlsplit(origin)
    if parts.scheme != "https" or not parts.hostname or parts.username or parts.password:
        raise ValueError("https")
    ctx = ssl.create_default_context()
    if insecure:
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
    conn = _Conn(parts.hostname, parts.port or 443, ctx, pin, 15)
    try:
        conn.request("POST", path, body=body, headers={"Content-Type": "application/json"})
        resp = conn.getresponse()
        resp.read()
        status = resp.status
    finally:
        conn.close()
    verdict = {200: "ok", 400: "bad request", 403: "forbidden", 409: "conflict",
               413: "too large", 415: "unsupported media type",
               429: "too many", 404: "not found"}.get(status, "bad request" if status >= 400 else "ok")
    return status, verdict


def _read_answer():
    text = sys.stdin.read()
    if text.endswith("\n"):
        text = text[:-1]
    if text.endswith("\r"):
        text = text[:-1]
    if not text or len(text) > 400:
        return None
    return text


def _seal_list_body(args):
    if not isinstance(args.request_id, str) or _RID.fullmatch(args.request_id) is None:
        print("400 bad request")
        return None, 1
    names = _read_list_names()
    if names is None:
        print("400 bad request")
        return None, 1
    seed = os.environ.get("GROK_STATION_BOT_KEY", "")
    if not seed.strip():
        print("missing GROK_STATION_BOT_KEY", file=sys.stderr)
        return None, 2
    try:
        return build_list_outer(args.bot, args.request_id, names, seed, args.station_pub), 0
    except Exception:
        print("400 bad request")
        return None, 1


def _seal_body(args):
    """Returns (body, rc). body is None on failure, rc is the exit code to use."""
    text = _read_answer()
    if text is None:
        print("400 bad request")
        return None, 1
    seed = os.environ.get("GROK_STATION_BOT_KEY", "")
    if not seed.strip():
        print("missing GROK_STATION_BOT_KEY", file=sys.stderr)
        return None, 2
    try:
        return build_outer(args.bot, args.request_id, text, seed, args.station_pub), 0
    except Exception:
        print("400 bad request")
        return None, 1


def _post_args(args):
    if args.insecure and not args.pin_sha256:
        print("insecure requires --pin-sha256", file=sys.stderr)
        return None
    pin = ""
    if args.pin_sha256:
        pin = _pin(args.pin_sha256)
        if not pin:
            print("bad pin", file=sys.stderr)
            return None
    return pin


def _read_image():
    """Image bytes from stdin, at most 2 MB. None when missing, too big, or not png, jpeg, or webp."""
    cap = AVATAR_IMAGE_MAX + 1
    src = sys.stdin.buffer if hasattr(sys.stdin, "buffer") else sys.stdin
    try:
        raw = src.read(cap)
    except Exception:
        return None
    if isinstance(raw, str):
        raw = raw.encode("latin-1")
    if not isinstance(raw, (bytes, bytearray)) or not raw or len(raw) > AVATAR_IMAGE_MAX:
        return None
    if not sniff_image(raw):
        return None
    return bytes(raw)


def _seal_avatar_body(args):
    image = _read_image()
    if image is None:
        print("400 bad request")
        return None, 1
    seed = os.environ.get("GROK_STATION_BOT_KEY", "")
    if not seed.strip():
        print("missing GROK_STATION_BOT_KEY", file=sys.stderr)
        return None, 2
    try:
        return build_avatar(args.bot, image, seed, args.station_pub), 0
    except Exception:
        print("400 bad request")
        return None, 1


def _read_show():
    raw = sys.stdin.buffer.read(9000) if hasattr(sys.stdin, "buffer") else sys.stdin.read(9000).encode()
    if not raw or len(raw) > MAX_BODY:
        return None
    try:
        doc = json.loads(raw.decode())
    except Exception:
        return None
    return doc if isinstance(doc, dict) else None


def _do_post(args, body, pin, path="/voice/reply"):
    try:
        status, verdict = post_reply(args.station, body, insecure=args.insecure, pin=pin, path=path)
    except ssl.SSLError as e:
        if "pin" in str(e):
            print("certificate pin mismatch")
            return 1
        print("tls error", file=sys.stderr)
        return 1
    except Exception:
        print("tls error", file=sys.stderr)
        return 1
    print(f"{status} {verdict}")
    return 0 if status == 200 else 1


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if _refused(argv):
        print("refused", file=sys.stderr)
        return 2
    p = argparse.ArgumentParser(prog="grok-station-reply", add_help=True)
    sub = p.add_subparsers(dest="cmd")
    sub.add_parser("keygen")
    send = sub.add_parser("send")
    seal = sub.add_parser("seal")
    seal_list = sub.add_parser("seal-list")
    post = sub.add_parser("post")
    for sp in (send, post):
        sp.add_argument("--station", required=True)
        sp.add_argument("--insecure", action="store_true")
        sp.add_argument("--pin-sha256", default="")
    for sp in (send, seal, seal_list):
        sp.add_argument("--bot", required=True)
        sp.add_argument("--station-pub", required=True)
        sp.add_argument("--request-id", required=True)
    post.add_argument("--show", action="store_true", help="post a sealed card (from seal-show) to /voice/show")
    post.add_argument("--avatar", action="store_true", help="post a sealed picture (from seal-avatar) to /voice/avatar")
    seal_show = sub.add_parser("seal-show")
    seal_show.add_argument("--bot", required=True)
    seal_show.add_argument("--station-pub", required=True)
    seal_avatar = sub.add_parser("seal-avatar")
    seal_avatar.add_argument("--bot", required=True)
    seal_avatar.add_argument("--station-pub", required=True)
    show = sub.add_parser("show")
    show.add_argument("--bot", required=True)
    show.add_argument("--station-pub", required=True)
    show.add_argument("--station", required=True)
    show.add_argument("--insecure", action="store_true")
    show.add_argument("--pin-sha256", default="")
    try:
        args = p.parse_args(argv)
    except SystemExit as e:
        return int(e.code or 0)
    if args.cmd == "keygen":
        for line in keygen_lines():
            print(line)
        return 0
    if args.cmd == "seal":
        body, rc = _seal_body(args)
        if body is None:
            return rc
        print(body.decode())
        return 0
    if args.cmd == "seal-list":
        body, rc = _seal_list_body(args)
        if body is None:
            return rc
        print(body.decode())
        return 0
    if args.cmd == "seal-show":  # cloud computer: seal a card; the home machine posts it with post --show
        doc = _read_show()
        if doc is None:
            print("400 bad request")
            return 1
        seed = os.environ.get("GROK_STATION_BOT_KEY", "")
        if not seed.strip():
            print("missing GROK_STATION_BOT_KEY", file=sys.stderr)
            return 2
        try:
            body = build_show(args.bot, doc, seed, args.station_pub)
        except Exception:
            print("400 bad request")
            return 1
        print(body.decode())
        return 0
    if args.cmd == "seal-avatar":  # cloud computer: seal a picture; the home machine posts it with post --avatar
        body, rc = _seal_avatar_body(args)
        if body is None:
            return rc
        print(body.decode())
        return 0
    if args.cmd == "post":
        if args.show and args.avatar:
            print("400 bad request")
            return 1
        pin = _post_args(args)
        if pin is None:
            return 2
        incoming = sys.stdin.buffer.read() if hasattr(sys.stdin, "buffer") else sys.stdin.read()
        body = check_outer(incoming, limit=AVATAR_OUTER_MAX if args.avatar else None)
        if body is None:
            print("400 bad request")
            return 1
        path = "/voice/avatar" if args.avatar else ("/voice/show" if args.show else "/voice/reply")
        return _do_post(args, body, pin, path=path)
    if args.cmd == "send":
        pin = _post_args(args)
        if pin is None:
            return 2
        body, rc = _seal_body(args)
        if body is None:
            return rc
        return _do_post(args, body, pin)
    if args.cmd == "show":
        pin = _post_args(args)
        if pin is None:
            return 2
        doc = _read_show()
        if doc is None:
            print("400 bad request")
            return 1
        seed = os.environ.get("GROK_STATION_BOT_KEY", "")
        if not seed.strip():
            print("missing GROK_STATION_BOT_KEY", file=sys.stderr)
            return 2
        try:
            body = build_show(args.bot, doc, seed, args.station_pub)
        except Exception:
            print("400 bad request")
            return 1
        return _do_post(args, body, pin, path="/voice/show")
    p.print_help(sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
