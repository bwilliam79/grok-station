#!/bin/sh
# grok-station pre-push hook body (installed by tools/install-release-hook; the global hooks dispatcher runs it
# after pii-guard and the leak scan). Gates only pushes whose remote ref is refs/heads/main: such a push is
# blocked unless the pushed commit is the checked-out commit and tools/release-check.sh, run on that commit, ends
# with "release-check: PASS". Deleting main is refused. Every other ref (PR branches, new branches, deletes of
# other branches, tags) passes; in a mixed push the main line decides.
# stdin: one "<local ref> <local sha> <remote ref> <remote sha>" line per pushed ref (githooks pre-push). A last
# line without a newline still counts, a trailing CR is dropped, and a line that is not four fields is refused.
set -u
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR GIT_OBJECT_DIRECTORY
top=$(git rev-parse --show-toplevel) || exit 1
head=$(git -C "$top" rev-parse HEAD) || exit 1
cr=$(printf '\r')
main=refs/heads/main
n=0
# Read whole lines, the last one too when it has no newline, and drop one trailing CR. A non-blank line that is
# not exactly four fields is refused (git never writes one).
while IFS= read -r line || [ -n "$line" ]; do
  line=${line%"$cr"}
  set -f
  # shellcheck disable=SC2086
  set -- $line
  set +f
  [ "$#" -eq 0 ] && continue
  if [ "$#" -ne 4 ]; then
    echo "release-check hook: malformed pre-push line ($# fields); push blocked" >&2
    exit 1
  fi
  lref=$1 lsha=$2 rref=$3
  [ "$rref" = "$main" ] || continue
  case "$lsha" in
    *[!0]*) ;;
    *)
      echo "release-check hook: deleting $main is refused" >&2
      exit 1
      ;;
  esac
  n=$((n + 1))
  if [ "$lsha" != "$head" ]; then
    echo "release-check hook: $lref ($lsha) -> $main is not the checked-out commit $head; check out the exact tip and push it" >&2
    exit 1
  fi
done
[ "$n" -eq 0 ] && exit 0
if [ ! -f "$top/tools/release-check.sh" ]; then
  echo "release-check hook: $top/tools/release-check.sh is missing; push blocked" >&2
  exit 1
fi
log=$(mktemp "${TMPDIR:-/tmp}/release-check.XXXXXX") || exit 1
sh "$top/tools/release-check.sh" >"$log" 2>&1
rc=$?
last=$(tail -n 1 "$log")
if [ "$rc" -eq 0 ] && [ "$last" = "release-check: PASS" ]; then
  rm -f "$log"
  echo "release-check: PASS on $head" >&2
  exit 0
fi
grep '^FAIL' "$log" >&2
echo "release-check hook: push blocked, release-check did not print PASS on $head (log: $log)" >&2
exit 1
