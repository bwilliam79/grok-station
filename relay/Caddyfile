# LAN-only TLS front for the relay: wss with a required client certificate (mTLS) from a private CA.
# Certs are mounted read-only at /pki from a dir outside the repo: server.crt, server.key, client-ca.crt.
# No ACME, no Caddy admin endpoint, no HTTP listener. Proxied on :8443 (mTLS): /ws, /health, /personas,
# /portrait/<slug>, /enroll/*, /wakewords, /wakeword/* and /admin/* (the Bots admin API, including /admin/policy
# and /admin/bots/<slug>/avatar; the relay checks the bearer and this fingerprint).
# :8444 is TLS only, no client certificate, and proxies only POST /voice/avatar (bot portrait upload). Bots reach
# that path the same way they reach the relay: the station's TLS cert, no mTLS. Everything else on :8444 is 404.
# The client certificate's fingerprint is passed as X-Client-Cert-Fp (set here, so a client can't supply its own); the
# relay keys its bad-token lockout on it, so failed tries from one certificate can't lock out another.
{
	admin off
	auto_https off
	persist_config off
	servers {
		protocols h1 h2
	}
}

https://:8443 {
	tls /pki/server.crt /pki/server.key {
		protocols tls1.3
		client_auth {
			mode require_and_verify
			trust_pool file /pki/client-ca.crt
		}
	}
	# /admin/* is one segment in Caddy's path matcher (* does not cross '/'), so each extra segment is listed.
	# /admin/bots, /admin/bots/<slug>, .../webhook, .../test and .../test/<id> all reach the relay.
	@relay path /ws /health /personas /portrait/* /enroll/* /wakewords /wakeword/* /admin/* /admin/*/* /admin/*/*/* /admin/*/*/*/*
	handle @relay {
		reverse_proxy relay:8790 {
			header_up X-Client-Cert-Fp {http.request.tls.client.fingerprint}
		}
	}
	handle {
		respond 404
	}
	log {
		output stdout
		format console
	}
}

# Bot avatar upload. TLS 1.3, no client certificate. Only /voice/avatar is proxied; the relay checks the voice token.
https://:8444 {
	tls /pki/server.crt /pki/server.key {
		protocols tls1.3
	}
	@avatar path /voice/avatar
	handle @avatar {
		reverse_proxy relay:8790
	}
	handle {
		respond 404
	}
	log {
		output stdout
		format console
	}
}
