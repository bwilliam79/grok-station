# /etc/sudoers.d/grok-station-usb
# The wake listener (user grok, not root) may run only this helper, with
# arguments. The helper accepts one ALSA card (a number 0-99 or the card id)
# and no path. It resolves that card in sysfs, refuses anything that is not
# the configured speakerphone, and issues USBDEVFS_RESET on that device's
# usbfs node. It does not write the authorized file. No other command.
grok ALL=(root) NOPASSWD: /usr/local/lib/grok-station/gs-usb-reset
