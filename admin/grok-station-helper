#!/usr/bin/env python3
"""grok-station-helper: the admin page's only privileged path (root via sudo, see admin/sudoers.example).
Fixed subcommands, input validated here (never trust the caller), JSON on stdin/stdout, secrets never echoed."""
import configparser, grp, io, json, os, re, shutil, ssl, subprocess, sys, tarfile, tempfile, urllib.request, uuid

ENV = {"display": "/etc/grok-station/env", "wake": "/etc/grok-station/wake.env"}


def station_env_owner():
    """/etc/grok-station/env is root:grok 0640: the relay (group grok) reads the location from it."""
    return 0, grp.getgrnam("grok").gr_gid, 0o640
TLS = "/etc/grok-station/tls"
NM_DIR = "/etc/NetworkManager/system-connections"
REPO = "bwilliam79/grok-station"
HOTSPOT = "grok-hotspot"
SETTINGS = {  # section -> {key: (env file, validator)}
    # Dim levels, times, and coordinates are the strings the admin form already normalized
    # (2 decimal places, no leading zeros). A bad value fails here before the file is written.
    "display": {"GROK_STATION_HOLD": ("display", r"^([5-9]|[1-9]\d|[1-5]\d\d|600)$"),
                "GROK_STATION_NIGHT": ("display", r"^((\d|1\d|2[0-3])-(\d|1\d|2[0-3]))?$"),
                "GROK_STATION_UNITS": ("display", r"^(fahrenheit|celsius)$"),
                "GROK_STATION_FADE": ("display", r"^[01]$"),
                "GROK_STATION_DIM_MODE": ("display", r"^(off|schedule|sun|auto-sensor)$"),
                "GROK_STATION_DIM_DAY": ("display", r"^(?:100|[1-9]?\d)$"),
                "GROK_STATION_DIM_NIGHT": ("display", r"^(?:100|[1-9]?\d)$"),
                "GROK_STATION_DIM_FROM": ("display", r"^(([01]\d|2[0-3]):[0-5]\d)?$"),
                "GROK_STATION_DIM_TO": ("display", r"^(([01]\d|2[0-3]):[0-5]\d)?$"),
                "GROK_STATION_DIM_LAT": ("display", r"^(-?(?:90\.00|[0-8]?\d\.\d{2}))?$"),
                "GROK_STATION_DIM_LON": ("display", r"^(-?(?:180\.00|(?:1[0-7]\d|[1-9]?\d)\.\d{2}))?$"),
                "GROK_STATION_DIM_SUNRISE": ("display", r"^-?(?:180|1[0-7]\d|[1-9]?\d)$"),
                "GROK_STATION_DIM_SUNSET": ("display", r"^-?(?:180|1[0-7]\d|[1-9]?\d)$")},
    "time": {"GROK_STATION_LAT": ("display", r"^-?\d{1,2}(\.\d{1,4})?$"), "GROK_STATION_LON": ("display", r"^-?\d{1,3}(\.\d{1,4})?$"),
             "GROK_STATION_UNITS": ("display", r"^(fahrenheit|celsius)$")},
    "audio": {"WAKE_DEVICE_NAME": ("wake", r"^[A-Za-z0-9 _.-]{1,40}$"), "WAKE_GAIN": ("wake", r"^\d(\.\d{1,2})?$"),
              "VOICE_GAIN": ("wake", r"^\d(\.\d{1,2})?$"), "WAKE_CAPTURE_RATE": ("wake", r"^(16000|48000)$"),
              "ALARM_SOUND": ("wake", None), "LISTEN_TONE": ("wake", None), "END_TONE": ("wake", None)},
}


def station_sounds():
    """Catalog module. Next to this checkout, else the installed copy. None if it isn't there."""
    import importlib.util
    cached = getattr(station_sounds, "_mod", None)
    if cached:
        return cached
    cands = []
    if os.environ.get("GROK_STATION_SOUNDS_PY"):
        cands.append(os.environ["GROK_STATION_SOUNDS_PY"])
    here = globals().get("__file__")
    if here:
        cands.append(os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(here))), "sounds.py"))
    cands.append("/opt/grok-station/sounds.py")
    for p in cands:
        if not p or not os.path.isfile(p):
            continue
        spec = importlib.util.spec_from_file_location("grok_station_sounds", p)
        if not spec or not spec.loader:
            continue
        mod = importlib.util.module_from_spec(spec)
        try:
            spec.loader.exec_module(mod)
        except Exception:
            continue
        station_sounds._mod = mod
        return mod
    return None


def station_gain():
    """wake/gain.py: device gain defaults. No numpy, so this helper can load it. None if it isn't there."""
    import importlib.util
    cached = getattr(station_gain, "_mod", None)
    if cached:
        return cached
    cands = []
    here = globals().get("__file__")
    if here:
        cands.append(os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(here))), "wake", "gain.py"))
    cands.append("/opt/grok-station/wake/gain.py")
    for p in cands:
        if not p or not os.path.isfile(p):
            continue
        spec = importlib.util.spec_from_file_location("grok_station_gain", p)
        if not spec or not spec.loader:
            continue
        mod = importlib.util.module_from_spec(spec)
        try:
            spec.loader.exec_module(mod)
        except Exception:
            continue
        station_gain._mod = mod
        return mod
    return None


def out(obj, code=0):
    print(json.dumps(obj))
    sys.exit(code)


def fail(msg):
    out({"error": msg}, 1)


def stdin_json():
    try:
        j = json.loads(sys.stdin.read(8192) or "{}")
        return j if isinstance(j, dict) else {}
    except ValueError:
        fail("bad input")


def run(*a, timeout=30, check=False):
    p = subprocess.run(list(a), capture_output=True, timeout=timeout)
    if check and p.returncode:
        raise RuntimeError(a[0])
    return p.returncode, p.stdout.decode(errors="replace")


def env_read(name):
    vals = {}
    try:
        for line in open(ENV[name]):
            m = re.match(r"^([A-Z_][A-Z0-9_]*)=(.*)$", line.strip())
            if m:
                vals[m.group(1)] = m.group(2).strip().strip('"')
    except OSError:
        pass
    return vals


def env_write(name, updates):
    f = ENV[name]
    try:
        lines = open(f).read().splitlines()
    except OSError:
        lines = []
    seen = set()
    for i, line in enumerate(lines):
        m = re.match(r"^([A-Z_][A-Z0-9_]*)=", line)
        if m and m.group(1) in updates:
            k = m.group(1)
            lines[i] = f'{k}="{updates[k]}"' if " " in updates[k] else f"{k}={updates[k]}"
            seen.add(k)
    for k, v in updates.items():
        if k not in seen:
            lines.append(f'{k}="{v}"' if " " in v else f"{k}={v}")
    if name == "display":
        uid, gid, mode = station_env_owner()
    else:  # keep whatever owner and mode the file has (new files: root-only)
        try:
            st = os.stat(f)
            uid, gid, mode = st.st_uid, st.st_gid, st.st_mode & 0o777
        except OSError:
            uid, gid, mode = os.getuid(), os.getgid(), 0o600
    tmp = f + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.fchown(fd, uid, gid)
    os.fchmod(fd, mode)
    with open(fd, "w") as fh:
        fh.write("\n".join(lines) + "\n")
    os.replace(tmp, f)


def settings_get(sec):
    if sec not in SETTINGS:
        fail("unknown section")
    vals = {}
    for k, (fname, _) in SETTINGS[sec].items():
        vals[k] = env_read(fname).get(k)
    body = {"values": vals}
    if sec == "time":
        _, tz = run("timedatectl", "show", "-p", "Timezone", "--value")
        vals["timezone"] = tz.strip()
    if sec == "audio":
        mod = station_sounds()
        if mod is not None:
            cat = mod.choices()
            body["sounds"] = cat
            for key, slot in (("ALARM_SOUND", "alarm"), ("LISTEN_TONE", "listen"), ("END_TONE", "end")):
                cur = vals.get(key)
                if not mod.allowed(key, cur if isinstance(cur, str) else ""):
                    vals[key] = cat["defaults"][slot]
        else:
            body["sounds"] = {"alarm": [], "listen": ["none"], "end": ["none"],
                              "defaults": {"alarm": "", "listen": "none", "end": "none"}}
            for key, default in (("ALARM_SOUND", ""), ("LISTEN_TONE", "none"), ("END_TONE", "none")):
                if not isinstance(vals.get(key), str):
                    vals[key] = default
        gmod = station_gain()
        if gmod is not None:
            # Effective gains for the saved device (blank device: the listener's EMEET default).
            # Stored lines stay in values; defaults is what the sliders show. A save that omits
            # WAKE_GAIN / VOICE_GAIN does not write them (settings_set only writes keys it was sent).
            device = vals.get("WAKE_DEVICE_NAME") or "EMEET"
            eff = gmod.effective_gains(device, vals.get("WAKE_GAIN"), vals.get("VOICE_GAIN"))
            body["defaults"] = {"WAKE_GAIN": eff["WAKE_GAIN"], "VOICE_GAIN": eff["VOICE_GAIN"]}
            body["gain_by_device"] = gmod.gain_by_device()
    out(body)


def settings_set(sec):
    if sec not in SETTINGS:
        fail("unknown section")
    j = stdin_json()
    upd = {}
    for k, v in j.items():
        if k == "timezone" and sec == "time":
            continue
        if k not in SETTINGS[sec]:
            fail(f"unknown setting {k}")
        v = str(v)
        rule = SETTINGS[sec][k][1]
        if rule is None:  # sound id: manifest allowlist, not a path-shaped regex
            mod = station_sounds()
            if mod is None or not mod.allowed(k, v):
                fail(f"bad value for {k}")
        elif not re.fullmatch(rule, v):
            fail(f"bad value for {k}")
        upd.setdefault(SETTINGS[sec][k][0], {})[k] = v
    if sec == "display":
        block = upd.get("display", {})
        cur = env_read("display")
        mode = block["GROK_STATION_DIM_MODE"] if "GROK_STATION_DIM_MODE" in block else (cur.get("GROK_STATION_DIM_MODE") or "")
        if mode == "schedule":
            start = block["GROK_STATION_DIM_FROM"] if "GROK_STATION_DIM_FROM" in block else (cur.get("GROK_STATION_DIM_FROM") or "")
            end = block["GROK_STATION_DIM_TO"] if "GROK_STATION_DIM_TO" in block else (cur.get("GROK_STATION_DIM_TO") or "")
            if not start or not end:
                fail("Dim from and dim until need a time like 22:00.")
    if sec == "time" and "timezone" in j:
        tz = str(j["timezone"])
        if not re.fullmatch(r"[A-Za-z_]+(/[A-Za-z0-9_+-]+){0,2}", tz) or not os.path.isfile("/usr/share/zoneinfo/" + tz):
            fail("unknown time zone")
        run("timedatectl", "set-timezone", tz, check=True)
    for fname, u in upd.items():
        env_write(fname, u)
    if "display" in upd:
        run("systemctl", "restart", "grok-station")
    out({"ok": True, "restart_wake": "wake" in upd})


def secret_status():
    t = env_read("wake").get("GROK_RELAY_TOKEN", "")
    out({"secrets": {"relay_token": {"set": bool(t), "last4": t[-4:] if t else None}}})


def relay_test():
    j = {} if sys.stdin.isatty() else stdin_json()
    env = env_read("wake")
    url = j.get("url") or env.get("GROK_RELAY_URL", "")
    tok = j.get("token") or env.get("GROK_RELAY_TOKEN", "")
    m = re.fullmatch(r"wss://([A-Za-z0-9.-]{1,253})(?::(\d{1,5}))?(/[A-Za-z0-9._~/-]*)?", url or "")
    if not m:
        fail("No relay address is set.")
    if not tok:
        fail("No station token is set.")
    host, port = m.group(1), m.group(2) or "443"
    checks = {"tls": False, "token": False, "xai_key": None}
    try:
        ctx = ssl.create_default_context(cafile=f"{TLS}/ca.crt")
        ctx.load_cert_chain(f"{TLS}/client.crt", f"{TLS}/client.key")
        req = urllib.request.Request(f"https://{host}:{port}/health", headers={"Authorization": f"Bearer {tok}"})
        with urllib.request.urlopen(req, timeout=10, context=ctx) as r:
            h = json.loads(r.read(65536) or b"{}")
        checks["tls"] = True
        checks["token"] = "key" in h  # details only come back with a valid token
        checks["xai_key"] = h.get("key")
    except ssl.SSLError:
        out({"error": "The secure connection failed (certificate).", "checks": checks}, 1)
    except Exception:
        out({"error": "Couldn't reach the voice service.", "checks": checks}, 1)
    try:
        exp = ssl._ssl._test_decode_cert(f"{TLS}/client.crt").get("notAfter")
    except Exception:
        exp = None
    checks["client_cert_expires"] = exp
    if not checks["token"]:
        out({"error": "The voice service didn't accept the station token.", "checks": checks}, 1)
    out({"ok": True, "checks": checks})




UPDATE_UNIT = "grok-station-update.service"  # fixed: the only unit these two commands touch
INSTALL_LOG = "/var/log/grok-station-install.log"


def update_start():
    """Start the fixed update unit (git pull + install.sh, see tools/grok-station-update). Stdin is ignored."""
    rc, _ = run("systemctl", "start", "--no-block", UPDATE_UNIT)
    if rc:
        fail("start")
    out({"ok": True})


def _one_line(text):
    """A single short failure line. Never a log dump, and never a line that looks like a secret."""
    s = " ".join(str(text or "").split())[:160]
    low = s.lower()
    if not s or "bearer " in low or "-----begin" in low or "password=" in low or "://" in s:
        return "The update failed."
    return s


def update_remote():
    """Fetch origin/main in the clone install.sh recorded, and report its VERSION plus full commit id.

    Stdin is ignored. No credentials are read. A missing VERSION is an empty string, not an error:
    the admin treats that as not an upgrade.
    """
    try:
        src = open("/etc/grok-station/source-dir", encoding="utf-8").read().strip()
    except OSError:
        fail("no source")
    if not src or "\n" in src or "\x00" in src or not os.path.isdir(os.path.join(src, ".git")):
        fail("no source")

    # Run git as the clone's owner. A root fetch leaves root-owned files in .git (FETCH_HEAD, objects), and the
    # owner's own git pull during the update then fails with a permission error.
    try:
        import pwd
        owner = pwd.getpwuid(os.stat(src).st_uid).pw_name
    except (OSError, KeyError):
        fail("no source")
    who = [] if owner == "root" else ["runuser", "-u", owner, "--"]

    def g(*args, timeout=30):
        return run(*who, "git", "-c", "safe.directory=" + src, "-C", src, *args, timeout=timeout)

    try:
        rc, _ = g("fetch", "--quiet", "origin", "main", timeout=25)
        if rc:
            fail("fetch")
        rc, blob = g("show", "origin/main:VERSION", timeout=15)
        rc2, sha = g("rev-parse", "origin/main", timeout=15)
    except subprocess.TimeoutExpired:
        fail("fetch")
    version = ""
    if rc == 0:
        line = blob.strip().splitlines()[0].strip() if blob.strip() else ""
        if re.fullmatch(r"\d+\.\d+\.\d+", line):
            version = line
    sha = sha.strip().lower()
    if rc2 or not re.fullmatch(r"[0-9a-f]{40}", sha):
        fail("rev")
    out({"version": version, "sha": sha})


def update_status():
    """{state: idle|running|succeeded|failed, error?: one line}. The install log stays on disk."""
    _, text = run("systemctl", "show", UPDATE_UNIT, "-p", "ActiveState", "-p", "Result", "-p", "ExecMainStartTimestampMonotonic")
    props = dict(line.split("=", 1) for line in text.splitlines() if "=" in line)
    act, res = props.get("ActiveState", ""), props.get("Result", "")
    started = props.get("ExecMainStartTimestampMonotonic", "0") not in ("", "0")
    if act in ("activating", "active", "reloading"):
        state = "running"
    elif act == "failed" or (started and res not in ("", "success")):
        state = "failed"
    elif started:
        state = "succeeded"
    else:
        state = "idle"
    body = {"state": state}
    if state == "failed":
        err = ""
        try:
            with open(INSTALL_LOG, encoding="utf-8", errors="replace") as f:
                lines = [ln.strip() for ln in f.readlines() if ln.strip()]
            if lines:
                err = lines[-1]
        except OSError:
            pass
        body["error"] = _one_line(err)
    out(body)


def nm(*a, timeout=30):
    return run("nmcli", "-t", *a, timeout=timeout)


def split_t(line):
    return [x.replace("\\:", ":") for x in re.split(r"(?<!\\):", line)]


def net_status():
    _, devs = nm("-f", "DEVICE,TYPE,STATE,CONNECTION", "dev")
    wired = wifi = False
    hotspot = False
    for l in devs.splitlines():
        d, t, st, con = (split_t(l) + ["", "", "", ""])[:4]
        if st.startswith("connected"):
            if con == HOTSPOT:
                hotspot = True
            elif t == "ethernet":
                wired = True
            elif t == "wifi":
                wifi = True
    _, addrs = run("ip", "-4", "-o", "addr", "show")
    ips = {m.group(1): m.group(2) for m in re.finditer(r"^\d+: (\S+)\s+inet (\d+\.\d+\.\d+\.\d+)", addrs, re.M) if m.group(1) != "lo"}
    _, aps = nm("-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list", "--rescan", "no")
    cur, visible = None, set()
    for l in aps.splitlines():
        use, ssid, sig, sec = (split_t(l) + ["", "", "", ""])[:4]
        if ssid:
            visible.add(ssid)
        if use == "*" and ssid:
            cur = {"ssid": ssid, "signal": int(sig or 0), "secure": bool(sec)}
    _, cons = nm("-f", "NAME,TYPE", "con", "show")
    saved = []
    for l in cons.splitlines():
        name, t = (split_t(l) + ["", ""])[:2]
        if t == "802-11-wireless" and name != HOTSPOT:
            ssid = ssid_of(name)
            saved.append({"name": name, "ssid": ssid, "managed": name.startswith("netplan-")})
    out({"connected": wired or wifi, "wired": wired, "wifi": cur if wifi else None, "ips": ips, "hotspot": hotspot,
         "saved": [{"ssid": s["ssid"], "managed": s["managed"]} for s in saved],
         "saved_in_range": any(s["ssid"] in visible for s in saved)})


def ssid_of(con):
    _, o = nm("-g", "802-11-wireless.ssid", "con", "show", con)
    return o.strip()


def wifi_scan():
    _, aps = nm("-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list", "--rescan", "yes", timeout=30)
    nets = {}
    for l in aps.splitlines():
        use, ssid, sig, sec = (split_t(l) + ["", "", "", ""])[:4]
        if ssid and (ssid not in nets or int(sig or 0) > nets[ssid]["signal"]):
            nets[ssid] = {"ssid": ssid, "signal": int(sig or 0), "secure": bool(sec and sec != "--"), "in_use": use == "*"}
    out({"networks": sorted(nets.values(), key=lambda n: -n["signal"])})


def wifi_join():
    j = stdin_json()
    ssid, pw, hidden = str(j.get("ssid", "")), j.get("password"), bool(j.get("hidden"))
    if not 1 <= len(ssid.encode()) <= 32 or any(c in ssid for c in "\n\r\x00"):
        fail("bad network name")
    if pw is not None and (not 8 <= len(str(pw)) <= 63 or any(c in str(pw) for c in "\n\r\x00")):
        fail("bad password")
    cid = str(uuid.uuid4())
    name = "gs-" + re.sub(r"[^A-Za-z0-9_-]", "_", ssid)[:24]
    cp = configparser.ConfigParser(interpolation=None)
    cp.optionxform = str
    cp["connection"] = {"id": name, "uuid": cid, "type": "wifi", "autoconnect": "true"}
    cp["wifi"] = {"mode": "infrastructure", "ssid": ssid, **({"hidden": "true"} if hidden else {})}
    if pw:
        cp["wifi-security"] = {"key-mgmt": "wpa-psk", "psk": str(pw)}
    cp["ipv4"] = {"method": "auto"}
    cp["ipv6"] = {"method": "auto"}
    f = os.path.join(NM_DIR, f"{name}.nmconnection")
    buf = io.StringIO()
    cp.write(buf)
    with open(os.open(f, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as fh:
        fh.write(buf.getvalue())
    nm("con", "reload")
    rc, _ = nm("con", "up", "uuid", cid, timeout=50)
    if rc:
        nm("con", "delete", "uuid", cid)  # NetworkManager falls back to the previous network
        fail("Couldn't join that network. The old network stays on.")
    out({"ok": True})


def wifi_forget():
    ssid = str(stdin_json().get("ssid", ""))
    _, cons = nm("-f", "NAME,TYPE,DEVICE", "con", "show")
    for l in cons.splitlines():
        name, t, dev = (split_t(l) + ["", "", ""])[:3]
        if t == "802-11-wireless" and name != HOTSPOT and ssid_of(name) == ssid:
            if name.startswith("netplan-"):
                fail("This network was set up when the station was installed; change it from the system image.")
            if dev:
                fail("That's the network the station is using now. Join another one first.")
            nm("con", "delete", name)
            out({"ok": True})
    fail("Not a saved network.")


def hotspot_start():
    j = stdin_json()
    ssid, pw = str(j.get("ssid", "")), str(j.get("password", ""))
    if not re.fullmatch(r"grok-station-[0-9A-F]{4}", ssid) or not re.fullmatch(r"hearth-\d{4}", pw):
        fail("bad hotspot")
    _, st = nm("-f", "DEVICE,TYPE,STATE", "dev")
    if any(split_t(l)[2].startswith("connected") and split_t(l)[1] in ("ethernet", "wifi") for l in st.splitlines() if l.count(":") >= 2):
        fail("a network is up; no hotspot")
    rc, _ = nm("dev", "wifi", "hotspot", "ifname", "wlan0", "con-name", HOTSPOT, "ssid", ssid, "password", pw, timeout=40)
    if rc:
        fail("hotspot failed")
    out({"ok": True, "url": "https://10.42.0.1"})


def hotspot_stop():
    nm("con", "down", HOTSPOT)
    nm("con", "delete", HOTSPOT)
    out({"ok": True})


def set_hostname(h):
    if not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?", h):
        fail("bad hostname")
    run("hostnamectl", "set-hostname", h, check=True)
    try:
        lines = open("/etc/hosts").read().splitlines()
        lines = [l for l in lines if not l.startswith("127.0.1.1")] + [f"127.0.1.1\t{h}"]
        open("/etc/hosts", "w").write("\n".join(lines) + "\n")
    except OSError:
        pass
    run("systemctl", "restart", "avahi-daemon")
    out({"ok": True})


XAI_KEY_FILE = "/etc/grok-station/secrets/xai_api_key"


def xai_key_set():
    """stdin {"key"}: write the relay's xAI key (0400, grok-relay only), then restart the relay. Never echoed."""
    j = stdin_json()
    k = str(j.get("key", "")).strip()
    if not re.fullmatch(r"[A-Za-z0-9._-]{20,200}", k):
        fail("bad key")
    import pwd, grp, tempfile
    d = os.path.dirname(XAI_KEY_FILE)
    os.makedirs(d, mode=0o711, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".k.", dir=d)
    try:
        os.write(fd, (k + "\n").encode())
        os.fsync(fd)
    finally:
        os.close(fd)
    k = None
    os.chown(tmp, pwd.getpwnam("grok-relay").pw_uid, grp.getgrnam("grok-admin").gr_gid)
    os.chmod(tmp, 0o400)
    os.replace(tmp, XAI_KEY_FILE)
    run("systemctl", "restart", "grok-station-relay")
    out({"ok": True})


def restart(what):
    unit = {"display": "grok-station", "wake": "grok-station-wake", "admin": "grok-station-admin",
            "relay": "grok-station-relay"}.get(what)
    if not unit:
        fail("unknown service")
    run("systemctl", "restart", unit)
    out({"ok": True})


def update(sha):
    """Install a specific commit of the public repo (files only; no apt). The previous files stay on failure."""
    if not re.fullmatch(r"[0-9a-f]{40}", sha):
        fail("bad version")
    d = tempfile.mkdtemp(prefix="gs-update-")
    try:
        url = f"https://codeload.github.com/{REPO}/tar.gz/{sha}"
        with urllib.request.urlopen(url, timeout=60) as r, tarfile.open(fileobj=io.BytesIO(r.read(50 * 1024 * 1024)), mode="r:gz") as t:
            t.extractall(d, filter="data")
        src = os.path.join(d, os.listdir(d)[0])
        for f in ("app/grok_station.py", "wake/grok_wake.py", "admin/grok_admin.py", "admin/grok-station-helper", "tools/grok-station"):
            if not os.path.isfile(os.path.join(src, f)):
                fail("update is missing files")
        run(sys.executable, "-m", "py_compile", os.path.join(src, "app/grok_station.py"), os.path.join(src, "wake/grok_wake.py"),
            os.path.join(src, "admin/grok_admin.py"), check=True)
        rc, _ = run("sh", os.path.join(src, "tools/install-files.sh"), src, sha[:7], timeout=120)
        if rc:
            fail("install step failed")
    except SystemExit:
        raise
    except Exception:
        fail("Update failed; the old version is still running.")
    finally:
        shutil.rmtree(d, ignore_errors=True)
    out({"ok": True})


