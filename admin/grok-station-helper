    a = sys.argv[1:]
    if not a:
        fail("usage")
    cmd = a[0]
    if cmd == "env-get" and len(a) == 2 and a[1] in ENV:
        v = env_read(a[1])
        out({"values": {k: x for k, x in v.items() if "TOKEN" not in k and "KEY" not in k}})
    if cmd == "settings-get" and len(a) == 2:
        settings_get(a[1])
    if cmd == "settings-set" and len(a) == 2:
        settings_set(a[1])
    if cmd == "secret-status":
        secret_status()
    if cmd == "relay-test":
        relay_test()
    if cmd == "update-remote" and len(a) == 1:
        update_remote()
    if cmd == "update-start" and len(a) == 1:
        update_start()
    if cmd == "update-status" and len(a) == 1:
        update_status()
    if cmd == "net-status":
        net_status()
    if cmd == "wifi-scan":
        wifi_scan()
    if cmd == "wifi-join":
        wifi_join()
    if cmd == "wifi-forget":
        wifi_forget()
    if cmd == "hotspot-start":
        hotspot_start()
    if cmd == "hotspot-stop":
        hotspot_stop()
    if cmd == "hostname" and len(a) == 2:
